{
  "name": "todo_list_app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "lighthouse": "npx lighthouse http://localhost:4173/ --view --output-path=./lighthouse-report.html",
    "audit": "npm run build && npm run preview & npm run lighthouse",
    "serve": "http-server ./dist -p 4173",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "code:fix": "npm run lint && npm run format"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.3.4",
    "pinia": "^2.0.35",
    "vue": "^3.2.47",
    "vue-router": "^4.1.6"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitejs/plugin-vue": "^4.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-vue": "^10.1.0",
    "http-server": "^14.1.1",
    "lighthouse": "^11.0.0",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^6.0.1",
    "terser": "^5.19.0",
    "vite": "^4.3.4",
    "vite-plugin-pwa": "^0.17.0",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vue-eslint-parser": "^10.1.3"
  }
}
